{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "class": "advisory",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/brother_hook.py\" SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "class": "advisory",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/brother_hook.py\" SessionEnd",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "class": "advisory",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/brother_hook.py\" Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "class": "advisory",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/brother_hook.py\" PreCompact",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|CreateDirectory|Delete|apply_patch",
        "hooks": [
          {
            "type": "command",
            "class": "deny",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/brother_hook.py\" PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Skill",
        "hooks": [
          {
            "type": "command",
            "class": "advisory",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/runtime/hooks/brother_hook.py\" PostToolUse",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
